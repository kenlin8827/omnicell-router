{
  "name": "@omnicell-router/backend",
  "version": "0.3.0",
  "description": "High-performance OmniCellRouter (OCR) Gateway & CLI Core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "bun --no-env-file --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test --no-env-file tests",
    "test:node": "tsx --test tests/**/*.test.ts",
    "start": "node dist/index.js",
    "start:bun": "bun --no-env-file src/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@zip.js/zip.js": "^2.23.0",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "node-forge": "^1.4.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/node-forge": "^1.3.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
