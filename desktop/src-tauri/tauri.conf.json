{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniCellRouter",
  "mainBinaryName": "OmniCellRouter",
  "version": "0.4.1",
  "identifier": "com.kenlin8827.omnicell-router",
  "build": {
    "frontendDist": "stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": { "../../frontend/dist/": "frontend/dist/" },
    "externalBin": ["bin/ocr-backend"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
