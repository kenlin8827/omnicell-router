{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniCellRouter",
  "mainBinaryName": "OmniCellRouter",
  "version": "0.6.3",
  "identifier": "com.kenlin8827.omnicell-router",
  "build": {
    "frontendDist": "stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": "(https?://|mailto:|tel:|file://|[A-Za-z]:[\\\\/]|\\\\\\\\|/).*"
    }
   },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": { "../../frontend/dist/": "frontend/dist/" },
    "externalBin": ["bin/ocr-backend"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "template": "./nsis/installer.nsi",
        "languages": [
          "English",
          "SimpChinese",
          "Spanish",
          "French",
          "German",
          "Japanese",
          "Korean",
          "PortugueseBR"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
