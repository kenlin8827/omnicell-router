{
  "name": "opencode-router-monorepo",
  "version": "0.0.1",
  "description": "High-performance OpenCode Router (OCR) & Cascading Gateway",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "ocr": "bun --no-env-file backend/src/cli/index.ts",
    "setup": "bun install && bun run build",
    "dev": "bun --no-env-file scripts/dev.ts",
    "dev:backend": "bun --filter @opencode-router/backend dev",
    "dev:frontend": "bun --filter @opencode-router/frontend dev",
    "build": "tsc -p backend && vite build frontend",
    "build:backend": "tsc -p backend",
    "build:frontend": "vite build frontend",
    "start": "node backend/dist/index.js",
    "start:bun": "bun --no-env-file backend/src/index.ts",
    "test": "bun --no-env-file scripts/test-isolated.ts",
    "check:matrix": "bun scripts/check-guardrails-matrix.ts",
    "test:node": "tsx --test backend/tests/**/*.test.ts",
    "test:system": "bun --no-env-file scripts/full-system-test.ts",
    "typecheck": "tsc -p backend --noEmit && tsc -p frontend --noEmit",
    "train:layer1": "bun --no-env-file scripts/train-layer1-classifier.ts",
    "flywheel:stats": "bun --no-env-file scripts/flywheel-stats.ts",
    "flywheel:prune": "bun --no-env-file scripts/flywheel-prune.ts"
  },
  "keywords": [
    "llm",
    "router",
    "finops",
    "cascading",
    "openai-proxy",
    "semantic-cache",
    "deepseek",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "bin": {
    "ocr": "./bin/ocr",
    "opencode-router": "./bin/opencode-router"
  }
}