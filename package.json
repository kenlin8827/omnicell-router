{
  "name": "omnicell-router",
  "version": "0.3.1",
  "description": "High-performance OmniCellRouter (OCR) & Cascading Gateway",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "backend/dist",
    "frontend/dist",
    "README.md",
    "README.zh-CN.md",
    "RELEASING.md",
    "RELEASING.zh-CN.md",
    "LICENSE"
  ],
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "ocr": "bun --no-env-file backend/src/cli/index.ts",
    "version": "bun --no-env-file scripts/version-sync.ts",
    "setup": "bun install && bun run build",
    "dev": "PORT=3000 bun --no-env-file scripts/dev.ts",
    "dev:backend": "bun --filter @omnicell-router/backend dev",
    "dev:frontend": "bun --filter @omnicell-router/frontend dev",
    "build": "tsc -p backend && vite build frontend",
    "build:backend": "tsc -p backend",
    "build:frontend": "vite build frontend",
    "build:sidecar": "cd desktop && bun run sidecar",
    "build:desktop": "bun run build && bun run build:sidecar && cd desktop && bun run build",
    "start": "node backend/dist/index.js",
    "start:bun": "bun --no-env-file backend/src/index.ts",
    "test": "bun --no-env-file scripts/test-isolated.ts",
    "check:matrix": "bun --no-env-file scripts/check-guardrails-matrix.ts",
    "test:node": "tsx --test backend/tests/**/*.test.ts",
    "test:system": "bun --no-env-file scripts/full-system-test.ts",
    "typecheck": "tsc -p backend --noEmit && tsc -p frontend --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "llm",
    "router",
    "finops",
    "cascading",
    "openai-proxy",
    "semantic-cache",
    "deepseek",
    "anthropic"
  ],
  "author": "Ken Lin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenlin8827/omnicell-router.git"
  },
  "bugs": {
    "url": "https://github.com/kenlin8827/omnicell-router/issues"
  },
  "homepage": "https://github.com/kenlin8827/omnicell-router#readme",
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@zip.js/zip.js": "^2.23.0",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "node-forge": "^1.4.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "bin": {
    "ocr": "./bin/ocr.js",
    "omnicell-router": "./bin/ocr.js"
  }
}
