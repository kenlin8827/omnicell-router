node_modules/
dist/
# OCR reads no env file (dotenv removed, ADR-0018). This only guards against a
# stray .env — which the Bun runtime would auto-load — ever getting committed.
.env
*.log

# Local scratch space (agent / review notes, throwaway drafts). Never shipped —
# a note that matters belongs in docs/ or an ADR, not here.
.scratch/

# Runtime state never lives in the repository: every environment owns
# ~/.omnicell-router/envs/<name>/ (config.yaml, data/, models/, catalog/,
# traces/, capture/, webauth-secret). If a rule for a repo-root state dir ever
# reappears here, the layout has regressed — see docs/adr/0018.
